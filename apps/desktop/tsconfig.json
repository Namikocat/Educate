{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@subjects/*": ["../../subjects/*"],
      "@viz/*": ["../../packages/visualization-core/src/*"],
      "@assess/*": ["../../packages/assessment-core/src/*"],
      "@curriculum/*": ["../../packages/curriculum-core/src/*"]
    }
  },
  "include": ["src", "tests", "../../packages/*/src", "../../packages/*/tests"]
}
